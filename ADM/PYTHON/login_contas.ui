  <property name="styleSheet">
   <string notr="true">/* Container principal do formulário */
QWidget#Form {
    background-color: #e0e0e0; /* Fundo cinza para contrastar com o fundo geral do app */
    background-image: url(:/images/FUNDO_ADM_LOGIN.png);
    background-repeat: no-repeat;
    background-position: center;
    border: 4px double #000000; 
    border-radius: 8px;
    padding: 15px;
}

/* Títulos e Textos fixos */
QLabel {
    font-size: 24px; 
    color: #000000; 
    font-weight: bold;
    font-family: &quot;Impact&quot;, &quot;Arial Black&quot;, sans-serif;
    background-color: transparent; /* Mantém o texto limpo sobre o fundo */
}

/* Campos de entrada de texto (Linha Única) */
QLineEdit {
    background-color: #ffffff; /* Fundo branco para dar alto contraste com o texto */
    color: #000000; 
    font-size: 20px; 
    font-weight: bold;
    border: 3px solid #000000; /* Linha de nanquim grossa */
    border-radius: 0px; 
    padding: 8px;
    cursor: ibeam;
}

QLineEdit:hover {
    background-color: #808080; /* MUDOU: O fundo do campo fica cinza escuro ao passar o mouse */
    color: #ffffff; /* Texto inverte para branco para manter a leitura */
    border: 3px solid #000000; 
}

QLineEdit:focus {
    background-color: #ffffff;
    color: #000000;
    border: 5px solid #000000; /* Borda engrossa simulando traço forte de ação */
}

/* Campos de entrada de texto (Multilinha) */
QTextEdit {
    background-color: #ffffff; /* Fundo branco */
    color: #000000; 
    font-size: 18px; 
    border: 3px solid #000000;
    border-radius: 0px;
    padding: 10px;
    cursor: ibeam;
}

QTextEdit:hover {
    background-color: #808080; /* MUDOU: Fundo cinza escuro no hover */
    color: #ffffff;
    border: 3px solid #000000;
}

QTextEdit:focus {
    background-color: #ffffff;
    color: #000000;
    border: 5px solid #000000;
}

/* Botões de Ação estilo Onomatopeia */
QPushButton {
    background-color: #000000; /* Fundo totalmente preto */
    color: #ffffff; 
    font-size: 18px; 
    font-weight: bold;
    text-transform: uppercase; 
    border: 3px solid #000000;
    border-radius: 0px;
    padding: 10px 20px;
    cursor: pointinghand;
}

QPushButton:hover {
    background-color: #ffffff; /* MUDOU: Inverte o background para branco */
    color: #000000;
    border: 3px solid #000000;
}

QPushButton:pressed {
    background-color: #808080; /* MUDOU: Fundo cinza médio no clique (sombra de pressão) */
    color: #ffffff;
    border: 3px solid #000000;
}

QFrame#painel {
    background-color: rgba(218, 228, 235, 190);
    border: 1px solid rgba(255, 255, 255, 50);
    border-radius: 12px;
}</string>
